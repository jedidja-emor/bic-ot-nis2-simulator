# Copy to backend/.env (or set in the environment) before running.
#
# SECRET_KEY signs all JWTs. REQUIRED for production: generate a strong random
# value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If left unset/blank, the backend generates an ephemeral random key at startup
# (dev/simulator only; all tokens are invalidated on restart).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./data/beeincontrol.db
# Allowed CORS origins, comma separated. "*" is acceptable for the simulator.
CORS_ORIGINS=*
# bcrypt work factor (10 is fast enough for the simulator/tests).
BCRYPT_ROUNDS=10
